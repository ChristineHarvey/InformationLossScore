      "cell_type": "code",
      "source": [
        "# ==================================================================\n",
        "# 8 - COMPARING CANDIDATE SCORES\n",
        "# ==================================================================\n",
        "\n",
        "import plotly.express as px\n",
        "\n",
        "# copy only required columns with report_id as index\n",
        "df_compare = df[[\"report_id\"] + norm_metrics].copy().set_index(\"report_id\")\n",
        "\n",
        "print(df_compare.head())\n",
        "\n",
        "# reshape dataframe from wide to long format\n",
        "df_box = (df_compare.reset_index().melt(\n",
        "  id_vars=\"report_id\",\n",
        "  value_vars=norm_metrics,\n",
        "  var_name=\"Metric\",\n",
        "  value_name=\"Score\"\n",
        "  )\n",
        ")\n",
        "\n",
        "# shorter labels for plotting\n",
        "label_map = {\n",
        "  \"ROUGEdiff_R_norm\": \"ROUGE Loss\",\n",
        "  \"BERTdiff_R_norm\": \"BERT Loss\",\n",
        "  \"NER_Loss_norm\": \"NER Loss\",\n",
        "  \"ILS_20_80\": \"ILS 20:80\",\n",
        "  \"ILS_50_50\": \"ILS 50:50\",\n",
        "  \"ILS_80_20\": \"ILS 80:20\",\n",
        "  \"ILS_Distance_norm\": \"ILS Distance\"\n",
        "}\n",
        "\n",
        "df_box[\"Metric\"] = df_box[\"Metric\"].replace(label_map)\n",
        "\n",
        "# create side-by-side boxplots\n",
        "fig = px.box(\n",
        "    df_box,\n",
        "    x=\"Metric\",\n",
        "    y=\"Score\",\n",
        "    points=\"outliers\",\n",
        "    hover_data=[\"report_id\"],\n",
        "    title=\"Distribution of Normalised Information Loss Metrics\"\n",
        ")\n",
        "\n",
        "# format figure\n",
        "fig.update_layout(\n",
        "    xaxis_title=\"Metric\",\n",
        "    yaxis_title=\"Normalised Information Loss Score\",\n",
        "    yaxis=dict(range=[0, 1]),\n",
        "    width=1000,\n",
        "    height=600\n",
        ")\n",
        "\n",
        "fig.show()\n"
      ],
